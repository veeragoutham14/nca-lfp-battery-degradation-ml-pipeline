# Platform demo. Auth is off so the dashboard opens without a password.
# Set BATTRYML_AUTH_ENABLED=true and BATTRYML_AUTH_SECRET to require a login.
BATTRYML_SOURCE_ROOT=brain
BATTRYML_SOURCE_PYTHON=
BATTRYML_CATALOG_PATH=var/battryml.duckdb
BATTRYML_JOB_ROOT=var/jobs
BATTRYML_API_HOST=127.0.0.1
BATTRYML_API_PORT=8000
BATTRYML_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BATTRYML_WORKER_THREADS=2
BATTRYML_ML_WORKER_THREADS=1
BATTRYML_AUTH_ENABLED=false
BATTRYML_AUTH_USERNAME=admin
BATTRYML_AUTH_PASSWORD=
BATTRYML_AUTH_SECRET=
BATTRYML_AUTH_SESSION_HOURS=12

# Brain extractor. Used only if a stage opens PostgreSQL. Leave empty for the demo.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

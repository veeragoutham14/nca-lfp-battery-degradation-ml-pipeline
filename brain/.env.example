# Database credentials are read only by the raw extractor.
# Leave them empty when the pipeline runs from local Parquet.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional local storage settings. Relative paths are resolved from the brain root.
DATA_DIR=data
RAW_PARQUET_DIR=data/raw_parquet
CLASSIFIED_PARQUET_DIR=data/processed/classified_rows
EVENT_PARQUET_DIR=data/processed/events
CAPACITY_TREND_DIR=data/processed/capacity_trend
CAPACITY_ML_DIR=data/processed/capacity_ml

# Optional database connection tuning.
DB_CONNECT_TIMEOUT_S=30

# Battery telemetry column names.
TIMESTAMP_COL=time
SERIAL_COL=serial
CURRENT_COL=batt_current_a
VOLTAGE_COL=batt_voltage_v
SOC_COL=batt_soc_pct
SOH_COL=batt_soh_pct
MODULE_COUNT_COL=batt_modulecount
MODE_COL=operating_mode
EVENT_ID_COL=event_id

# DB extraction uses this predefined column profile by default.
EXTRACTION_COLUMN_PROFILE=soh_core

# Rows with -threshold <= current <= threshold are classified as rest.
REST_CURRENT_THRESHOLD_A=0.5

# Timestamp gaps larger than this become explicit event_missing rows.
EXPECTED_SAMPLE_INTERVAL_SECONDS=1.0
MISSING_GAP_THRESHOLD_SECONDS=60.0

# Capacity trend ML settings.
# Optional. Leave empty to use the measured capacity_ah of the first full cycle.
NOMINAL_CAPACITY_AH=
# Synthetic demonstration cutoff. Replace it if you load your own telemetry.
BMS_SOH_RELIABLE_AFTER=2023-01-15T00:00:00+00:00
MIN_REASONABLE_CAPACITY_AH=30.0
MAX_REASONABLE_CAPACITY_AH=80.0
# Optional training-quality filter for capacity rows interrupted by long rest periods.
EXCLUDE_HIGH_REST_RATIO_CAPACITY_ROWS=false
MAX_REST_TO_DISCHARGE_RATIO_FOR_TRAINING=1.0
# Options: historical_mean, historical_median, recent_median
USAGE_RATE_MODES=historical_mean,historical_median,recent_median
USAGE_RATE_MODE=historical_mean
RECENT_USAGE_DAYS=90
